PORT=3000
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=timbox
DB_USER=postgres
DB_PASSWORD=

JWT_SECRET=
RECAPTCHA_SECRET_KEY=

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-q4_K_M
OLLAMA_TIMEOUT_MS=120000
OLLAMA_KEEP_ALIVE=10m

CHATBOT_CONTEXT_FILE=C:/ruta/al/contexto_ollama.txt
CHATBOT_MAX_MESSAGE_LENGTH=1000

CHAT_PERSONA_MAX_MESSAGE_LENGTH=2000
CHAT_PERSONA_TOKEN_EXPIRATION_DAYS=30

# Correo. En desarrollo puede usarse Mailpit en localhost:1025.
CORREO_HABILITADO=false
CORREO_REINTENTOS_CRON=0 1-5 * * *
CORREO_REINTENTOS_ZONA_HORARIA=America/Mexico_City
CORREO_TAMANO_LOTE=10
# Un intento inmediato y hasta cinco reintentos nocturnos.
CORREO_MAX_INTENTOS=6
CORREO_BLOQUEO_EXPIRADO_MS=300000

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Notificaciones TIMBOX <notificaciones@timbox.local>
SMTP_MAX_CONNECTIONS=2
